{
    "extends": "./configs/tsconfig.base.json",
    "include": ["configs", "docs", "tools", "source"],
    "exclude": ["dist", "node_modules", "source/website"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "outDir": "dist",
        "paths": {
            "~/*": ["./*"],
            "@/talos/*": ["./source/vscode/*"],
            "@/website/*": ["./source/website/library/*"]
        }
    }
}
