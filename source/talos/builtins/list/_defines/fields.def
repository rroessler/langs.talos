//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(size)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the number of elements in a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(empty)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `List` has no elements.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(front)
TALOS_XX_FIELDS_TYPEDEF("fn -> T")
TALOS_XX_FIELDS_DESCRIBE("Gets the first element of a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(back)
TALOS_XX_FIELDS_TYPEDEF("fn -> T")
TALOS_XX_FIELDS_DESCRIBE("Gets the last element of a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(get)
TALOS_XX_FIELDS_TYPEDEF("fn (index: Number) -> T")
TALOS_XX_FIELDS_DESCRIBE("Gets an element from a `List` by index.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(set)
TALOS_XX_FIELDS_TYPEDEF("fn (index: Number, value: T) -> T")
TALOS_XX_FIELDS_DESCRIBE("Sets an element in a `List` by index.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(map)
TALOS_XX_FIELDS_TYPEDEF("fn [V = Any](callback: fn (T?, Number?) -> V) -> List[V]")
TALOS_XX_FIELDS_DESCRIBE("Mutates each element in a `List` with a given transformation callback.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(fold)
TALOS_XX_FIELDS_TYPEDEF("fn [V = Any](initial: V, callback: fn (V, T) -> V) -> V")
TALOS_XX_FIELDS_DESCRIBE("Reduces all elements in a `List` to an accumulated value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(erase)
TALOS_XX_FIELDS_TYPEDEF("fn (start?: Number, end?: Number) -> List[T]")
TALOS_XX_FIELDS_DESCRIBE("Removes elements from a `List` indicated by a given range.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(slice)
TALOS_XX_FIELDS_TYPEDEF("fn (start?: Number, end?: Number) -> List[T]")
TALOS_XX_FIELDS_DESCRIBE("Creates a section of a `List` indicated by a given range.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(filter)
TALOS_XX_FIELDS_TYPEDEF("fn (callback?: (T) -> Boolean) -> List[T]")
TALOS_XX_FIELDS_DESCRIBE("Filters a `List` with a given predicate callback.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(reverse)
TALOS_XX_FIELDS_TYPEDEF("fn -> List[T]")
TALOS_XX_FIELDS_DESCRIBE("Reverses a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(push_front)
TALOS_XX_FIELDS_TYPEDEF("fn (...values: T) -> Number")
TALOS_XX_FIELDS_DESCRIBE("Pushes values onto a `List` from the front.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(push_back)
TALOS_XX_FIELDS_TYPEDEF("fn (...values: T) -> Number")
TALOS_XX_FIELDS_DESCRIBE("Pushes values onto a `List` from the back.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(pop_front)
TALOS_XX_FIELDS_TYPEDEF("fn -> T")
TALOS_XX_FIELDS_DESCRIBE("Pops the first element from a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(pop_back)
TALOS_XX_FIELDS_TYPEDEF("fn -> T")
TALOS_XX_FIELDS_DESCRIBE("Pops the last element from a `List` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(first_index_of)
TALOS_XX_FIELDS_TYPEDEF("fn (needle: T) -> Number")
TALOS_XX_FIELDS_DESCRIBE("Finds the index of the first element in a `List` that matches a given needle.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(last_index_of)
TALOS_XX_FIELDS_TYPEDEF("fn (needle: T) -> Number")
TALOS_XX_FIELDS_DESCRIBE("Finds the index of the last element in a `List` that matches a given needle.")
TALOS_XX_FIELDS_FOOTER()
