TALOS_XX_STATICS_TYPEDEF("fn [T](...values: T) -> List[T]")
TALOS_XX_STATICS_DESCRIBE("Creates a `List` from a collection of values.")
TALOS_XX_STATICS_FOOTER()

TALOS_XX_STATICS_HEADER()
TALOS_XX_STATICS_DEFINE(empty)
TALOS_XX_STATICS_TYPEDEF("fn [T = Any] -> List[T]")
TALOS_XX_STATICS_DESCRIBE("Creates an empty `List` value.")
TALOS_XX_STATICS_FOOTER()

TALOS_XX_STATICS_HEADER()
TALOS_XX_STATICS_DEFINE(range)
TALOS_XX_STATICS_TYPEDEF("fn (start?: Number, end?: Number, step?: Number) -> List[Number]")
TALOS_XX_STATICS_DESCRIBE("Creates a ranged `List` value.")
TALOS_XX_STATICS_FOOTER()

TALOS_XX_STATICS_HEADER()
TALOS_XX_STATICS_DEFINE(filled)
TALOS_XX_STATICS_TYPEDEF("fn [V](size: Number, value: V) -> List[V]")
TALOS_XX_STATICS_DESCRIBE("Creates a `List` filled to a size with a given value.")
TALOS_XX_STATICS_FOOTER()

