//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(sign)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the signum of a `Number`.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(abs)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the absolute value of a `Number`.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(ceil)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Rounds a `Number` up to its nearest integer value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(floor)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Rounds a `Number` down to its nearest integer value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(round)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Rounds a `Number` to its nearest integer value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(trunc)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Returns the integer part of a `Number` by removing any fractional digits.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(clamp)
TALOS_XX_FIELDS_TYPEDEF("fn (minimum?: Number, maximum?: Number) -> Number")
TALOS_XX_FIELDS_DESCRIBE("Ensures a `Number` is between two values, otherwise it returns the nearest boundary.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(is_nan)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `Number` is represented by a `NaN` value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(is_fin)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `Number` is represented by a finite value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(is_inf)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `Number` is represented by an infinite value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(to_precision)
TALOS_XX_FIELDS_TYPEDEF("fn (digits?: Number) -> String")
TALOS_XX_FIELDS_DESCRIBE("Converts a `Number` to a `String` with an optional number of significant digits.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(to_scientific)
TALOS_XX_FIELDS_TYPEDEF("fn (digits?: Number) -> String")
TALOS_XX_FIELDS_DESCRIBE("Converts a `Number` to a scientific `String` with an optional number of significant digits.")
TALOS_XX_FIELDS_FOOTER()

