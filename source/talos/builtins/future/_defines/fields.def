//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(then)
TALOS_XX_FIELDS_TYPEDEF("fn [V = Any](callback: fn (T) -> V | Future[V]) -> Future[V]")
TALOS_XX_FIELDS_DESCRIBE("Registers a callback to be called when this future is resolved.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(fails)
TALOS_XX_FIELDS_TYPEDEF("fn (callback: fn (Any?) -> T | Future[T]) -> Future[T]")
TALOS_XX_FIELDS_DESCRIBE("Registers a callback to be called when this future is rejected.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(await)
TALOS_XX_FIELDS_TYPEDEF("fn -> T")
TALOS_XX_FIELDS_DESCRIBE("Pauses execution of the current thread isolate until the future is fulfilled.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(state)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the current state of a `Future`.")
TALOS_XX_FIELDS_FOOTER()
