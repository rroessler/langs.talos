//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(is_okay)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `Result` contains a value.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(is_error)
TALOS_XX_FIELDS_TYPEDEF("fn -> Boolean")
TALOS_XX_FIELDS_DESCRIBE("Determines if a `Result` contains an error.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(unwrap_okay)
TALOS_XX_FIELDS_TYPEDEF("fn (message?: String) -> T")
TALOS_XX_FIELDS_DESCRIBE("Attempts getting an encapsulated value. If no value exists, the program will panic.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(unwrap_error)
TALOS_XX_FIELDS_TYPEDEF("fn (message?: String) -> E")
TALOS_XX_FIELDS_DESCRIBE("Attempts getting an encapsulated error. If no error exists, the program will panic.")
TALOS_XX_FIELDS_FOOTER()
