/// Builtins Includes
#include "talos/builtins/_inline/defines.ipp"

//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(print)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Void")
TALOS_XX_FIELDS_DESCRIBE("Prints to the standard output stream.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(eprint)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Void")
TALOS_XX_FIELDS_DESCRIBE("Prints to the standard error stream.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(println)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Void")
TALOS_XX_FIELDS_DESCRIBE("Prints to the standard output stream, with a newline.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(eprintln)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Void")
TALOS_XX_FIELDS_DESCRIBE("Prints to the standard error stream, with a newline.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(breakpoint)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Void")
TALOS_XX_FIELDS_DESCRIBE("Attempts to pause execution and pass control to the debugger.")
TALOS_XX_FIELDS_FOOTER()

