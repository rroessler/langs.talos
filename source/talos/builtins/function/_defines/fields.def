//  MACROS  //

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(bind)
TALOS_XX_FIELDS_TYPEDEF("fn (...args: Any) -> Function")
TALOS_XX_FIELDS_DESCRIBE("Creates a `Function` wrapped with the given arguments and context.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(arity)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the minimum expected arguments.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(adicity)
TALOS_XX_FIELDS_TYPEDEF("fn -> Number")
TALOS_XX_FIELDS_DESCRIBE("Gets the maximum expected arguments. If the function is variadic it will return the same value as `Function.vlimit()`.")
TALOS_XX_FIELDS_FOOTER()

TALOS_XX_FIELDS_HEADER()
TALOS_XX_FIELDS_DEFINE(receiver)
TALOS_XX_FIELDS_TYPEDEF("fn -> Any")
TALOS_XX_FIELDS_DESCRIBE("Gets the bound receiver context of a `Function`.")
TALOS_XX_FIELDS_FOOTER()
