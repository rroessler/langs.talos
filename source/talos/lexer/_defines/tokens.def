/// Vendor Modules
#include <xtdlib/xtdlib.hpp>

//  X-MACROS  //

#ifndef TALOS_XX_TOKEN_BASE
#define TALOS_XX_TOKEN_BASE(T, ...)
#endif

#ifndef TALOS_XX_TOKEN_SYMBOL
#define TALOS_XX_TOKEN_SYMBOL(T, S, ...) TALOS_XX_TOKEN_BASE(T, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_PUNC
#define TALOS_XX_TOKEN_PUNC(T, S, ...) TALOS_XX_TOKEN_SYMBOL(PUNC_##T, S, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_UNARY
#define TALOS_XX_TOKEN_UNARY(T, S, ...) TALOS_XX_TOKEN_SYMBOL(UNOP_##T, S, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_BINARY
#define TALOS_XX_TOKEN_BINARY(T, S, P, ...) TALOS_XX_TOKEN_SYMBOL(BINOP_##T, S, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_COMPARE
#define TALOS_XX_TOKEN_COMPARE(T, S, P, ...) TALOS_XX_TOKEN_BINARY(T, S, P, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_ASSIGN
#define TALOS_XX_TOKEN_ASSIGN(T, S, P, ...)     \
    TALOS_XX_TOKEN_BINARY(T, S, P, __VA_ARGS__) \
    TALOS_XX_TOKEN_SYMBOL(ASOP_##T, S "=", Flag::ASSIGNABLE $_PP_VARGS(__VA_ARGS__))
#endif

#ifndef TALOS_XX_TOKEN_KEYWORD
#define TALOS_XX_TOKEN_KEYWORD(T, K, ...) TALOS_XX_TOKEN_BASE(T, __VA_ARGS__)
#endif

#ifndef TALOS_XX_TOKEN_MODIFIER
#define TALOS_XX_TOKEN_MODIFIER(T, K, ...) TALOS_XX_TOKEN_KEYWORD(MOD_##T, K, Flag::MODIFIER $_PP_VARGS(__VA_ARGS__))
#endif

//  MACROS  //

/// Punctuation Tokens
TALOS_XX_TOKEN_PUNC(QUERY, "?")
TALOS_XX_TOKEN_PUNC(PERIOD, ".")
TALOS_XX_TOKEN_PUNC(SPREAD, "...")
TALOS_XX_TOKEN_PUNC(COLON, ":", Flag::TRAILING)
TALOS_XX_TOKEN_PUNC(POLICY, "::", Flag::TRAILING)
TALOS_XX_TOKEN_PUNC(COMMA, ",", Flag::TRAILING)
TALOS_XX_TOKEN_PUNC(TERM, ";", Flag::TRAILING, Flag::WHITESPACE)

TALOS_XX_TOKEN_PUNC(DECOR, "@", Flag::DECORATES, Flag::SYNCABLE)
TALOS_XX_TOKEN_PUNC(ATTRIB, "#", Flag::DECORATES, Flag::SYNCABLE)

TALOS_XX_TOKEN_PUNC(LPAREN, "(", Flag::LEADING)
TALOS_XX_TOKEN_PUNC(RPAREN, ")", Flag::TRAILING)
TALOS_XX_TOKEN_PUNC(LBRACE, "{", Flag::LEADING)
TALOS_XX_TOKEN_PUNC(RBRACE, "}", Flag::TRAILING)
TALOS_XX_TOKEN_PUNC(LBRACK, "[", Flag::LEADING)
TALOS_XX_TOKEN_PUNC(RBRACK, "]", Flag::TRAILING)

TALOS_XX_TOKEN_SYMBOL(ARROW_THIN, "->")
TALOS_XX_TOKEN_SYMBOL(ARROW_BOLD, "=>")

/// Operator Tokens
TALOS_XX_TOKEN_UNARY(NOT, "!")
TALOS_XX_TOKEN_UNARY(INC, "++")
TALOS_XX_TOKEN_UNARY(DEC, "--")
TALOS_XX_TOKEN_UNARY(INV, "~")

TALOS_XX_TOKEN_COMPARE(EQ, "==", EQUALITY)
TALOS_XX_TOKEN_COMPARE(NE, "!=", EQUALITY)
TALOS_XX_TOKEN_COMPARE(LE, "<=", COMPARISON)
TALOS_XX_TOKEN_COMPARE(GE, ">=", COMPARISON)
TALOS_XX_TOKEN_COMPARE(LT, "<", COMPARISON)
TALOS_XX_TOKEN_COMPARE(GT, ">", COMPARISON)

TALOS_XX_TOKEN_KEYWORD(BINOP_IN, "in", Flag::RESERVED)
TALOS_XX_TOKEN_KEYWORD(BINOP_IS, "is", Flag::RESERVED)
TALOS_XX_TOKEN_KEYWORD(BINOP_AS, "as", Flag::RESERVED)

TALOS_XX_TOKEN_ASSIGN(ADD, "+", TERM)
TALOS_XX_TOKEN_ASSIGN(SUB, "-", TERM)
TALOS_XX_TOKEN_ASSIGN(MUL, "*", FACTOR)
TALOS_XX_TOKEN_ASSIGN(DIV, "/", FACTOR)
TALOS_XX_TOKEN_ASSIGN(MOD, "%", FACTOR)
TALOS_XX_TOKEN_ASSIGN(POW, "**", EXPONENT)

TALOS_XX_TOKEN_ASSIGN(XOR, "^", XOR)
TALOS_XX_TOKEN_ASSIGN(SHL, "<<", SHIFT)
TALOS_XX_TOKEN_ASSIGN(SHR, ">>", SHIFT)

TALOS_XX_TOKEN_ASSIGN(BOR, "|", BOR)
TALOS_XX_TOKEN_ASSIGN(LOR, "||", LOR)
TALOS_XX_TOKEN_ASSIGN(BAND, "&", BAND)
TALOS_XX_TOKEN_ASSIGN(LAND, "&&", LAND)

TALOS_XX_TOKEN_BINARY(COAL, "??", COAL)
TALOS_XX_TOKEN_SYMBOL(ASOP_DEF, "=", Flag::ASSIGNABLE)

/// Literal Tokens
TALOS_XX_TOKEN_BASE(LTRL_BIN, Flag::NUMERIC)
TALOS_XX_TOKEN_BASE(LTRL_OCT, Flag::NUMERIC)
TALOS_XX_TOKEN_BASE(LTRL_HEX, Flag::NUMERIC)
TALOS_XX_TOKEN_BASE(LTRL_INT, Flag::NUMERIC)
TALOS_XX_TOKEN_BASE(LTRL_FLT, Flag::NUMERIC)

TALOS_XX_TOKEN_BASE(LTRL_STR)
TALOS_XX_TOKEN_BASE(LTRL_IDENT, Flag::ANNOTATION)

TALOS_XX_TOKEN_KEYWORD(LTRL_SELF, "Self", Flag::RESERVED)
TALOS_XX_TOKEN_KEYWORD(LTRL_VOID, "Void", Flag::ANNOTATION)
TALOS_XX_TOKEN_KEYWORD(LTRL_TRUE, "True", Flag::BOOLEAN, Flag::ANNOTATION)
TALOS_XX_TOKEN_KEYWORD(LTRL_FALSE, "False", Flag::BOOLEAN, Flag::ANNOTATION)

/// Keyword Tokens
TALOS_XX_TOKEN_KEYWORD(DECL_LET, "let", Flag::VARIABLE, Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(DECL_MUT, "mut", Flag::VARIABLE, Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(DECL_USE, "use", Flag::VARIABLE, Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(DECL_FUNC, "fn", Flag::RESERVED)
TALOS_XX_TOKEN_KEYWORD(DECL_ENUM, "enum", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(DECL_TYPE, "type", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(DECL_SPACE, "namespace", Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(DECL_IMPLEMENTS, "implements", Flag::ANNOTATION)
TALOS_XX_TOKEN_KEYWORD(DECL_CLASS, "class", Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(MOD_IMPORT, "import", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(MOD_EXPORT, "export", Flag::RESERVED, Flag::SYNCABLE, Flag::MODIFIER)

TALOS_XX_TOKEN_MODIFIER(PUBLIC, "public", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)
TALOS_XX_TOKEN_MODIFIER(PRIVATE, "private", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)
TALOS_XX_TOKEN_MODIFIER(PROTECTED, "protected", Flag::RESERVED, Flag::SYNCABLE, Flag::ACCESSOR)

TALOS_XX_TOKEN_KEYWORD(FLOW_ELSE, "else", Flag::RESERVED)
TALOS_XX_TOKEN_KEYWORD(FLOW_IF, "if", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(FLOW_MATCH, "match", Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(FLOW_BREAK, "break", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(FLOW_CONT, "continue", Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(FLOW_PANIC, "panic", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(FLOW_RETURN, "return", Flag::RESERVED, Flag::SYNCABLE)

TALOS_XX_TOKEN_KEYWORD(LOOP_FOR, "for", Flag::RESERVED, Flag::SYNCABLE)
TALOS_XX_TOKEN_KEYWORD(LOOP_ANY, "loop", Flag::RESERVED, Flag::SYNCABLE)

/// Core Token Values
TALOS_XX_TOKEN_BASE(MISC_CMT, Flag::WHITESPACE)

/// Sentinel Token Values
TALOS_XX_TOKEN_BASE(MISC_MAX)

//  UNDEFINES  //

#undef TALOS_XX_TOKEN_BASE
#undef TALOS_XX_TOKEN_SYMBOL
#undef TALOS_XX_TOKEN_PUNC
#undef TALOS_XX_TOKEN_UNARY
#undef TALOS_XX_TOKEN_BINARY
#undef TALOS_XX_TOKEN_COMPARE
#undef TALOS_XX_TOKEN_ASSIGN
#undef TALOS_XX_TOKEN_KEYWORD
#undef TALOS_XX_TOKEN_MODIFIER
