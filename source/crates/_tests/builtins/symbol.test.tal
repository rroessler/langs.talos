//!
//! Testing: Builtin "Symbol" Functionality.
//! Description: Coordinates testing the builtin "Symbol".
//!

// Talos Modules
import "talos:test" as Test;
import "talos:assert" as Assert;

// - TEST CASES - //

Test.suite("Methods", fn {
    let symbol = Symbol.from("symbol"); // prepare the symbol to be used now
    Test.case("Symbol.hash", fn => Assert.equals(symbol.hash(), symbol.hash()));
});

Test.suite("Statics", fn {
    Test.case("Symbol.of 'Number'", fn {
        Assert.equals(Symbol.from(42), Symbol.from(42));
        Assert.equals(Symbol.from(0.5), Symbol.from(0.5));
    });

    Test.case("Symbol.of 'String'", fn {
        Assert.equals(Symbol.from(""), Symbol.from(""));
        Assert.equals(Symbol.from("abc"), Symbol.from("abc"));
    });

    Test.case("Symbol.of 'Boolean'", fn {
        Assert.equals(Symbol.from(True), Symbol.from(True));
        Assert.equals(Symbol.from(False), Symbol.from(False));
    });
});
