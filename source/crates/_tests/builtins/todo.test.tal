///
/// @testing Builtin "Todo" Functionality.
/// @describe Coordinates testing the builtin "Todo".
///

// Talos Modules
import "talos:test" as Test;
import "talos:assert" as Assert;

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Call '()'", fn => Assert.panics(fn => Todo()));
    Test.case("Call 'String'", fn => Assert.panics(fn => Todo("...")));
});
