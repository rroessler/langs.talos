///
/// @testing Builtin "String" Functionality.
/// @describe Coordinates testing the builtin "String".
///

// Talos Modules
import "talos:test" as Test;
import "talos:assert" as Assert;

// - TEST CASES - //

Test.suite("Traits", fn {
    Test.case("Operator '+'", fn => Assert.equals("foo" + "bar", "foobar"));

    Test.case("Equality '=='", fn => Assert.equals("abc", "abc"));
    Test.case("Equality '!='", fn => Assert.differs("foo", "bar"));
});

Test.suite("Methods", fn {
    Test.todo("String.size '()'");
    Test.todo("String.empty '()'");
    Test.todo("String.bytes '()'");
    Test.todo("String.symbol '()'");

    Test.todo("String.at '()'");
    Test.todo("String.slice '()'");

    Test.todo("String.compare '()'");
    Test.todo("String.contains '()'");
    Test.todo("String.starts_with '()'");
    Test.todo("String.ends_with '()'");

    Test.todo("String.to_lower '()'");
    Test.todo("String.to_upper '()'");
    Test.todo("String.trim_both '()'");
    Test.todo("String.trim_leading '()'");
    Test.todo("String.trim_trailing '()'");
    Test.todo("String.pad_leading '()'");
    Test.todo("String.pad_trailing '()'");

    Test.todo("String.fmt '()'");
});

Test.suite("Statics", fn {
    Test.todo("String.from 'Any'");
    Test.todo("String.codepoint 'Number'");
});
