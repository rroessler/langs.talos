//!
//! Crate: "gc"
//! Description: Setup functions for garbage collection.
//!

// Dynamic Modules
import "dylib:gc" as gc;

// Talos Modules
import "talos:_detail" as Detail;

// - HELPERS - //

//! Brief: Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - PUBLIC METHODS - //

//! Brief: Gets the total GC cycles that have occurred.
export let cycles = m_cast[fn -> Number](gc.cycles);

//! Brief: Forcibly executes garbage collection.
//! Param: major                Senior mode flag.
export let collect = m_cast[fn (major?: Boolean) -> Void](gc.collect);
