//!
//! Crate: "memory"
//! Description: Utility functions for reading memory usage.
//!

// Dynamic Modules
import "dylib:jit" as jit;

// Talos Modules
import "talos:_detail" as Detail;

// - HELPERS - //

//! Brief: Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - PUBLIC METHODS - //

//! Brief: Gets the total heap memory.
export let compile = m_cast[fn [T: Function](callback: T) -> T](jit.compile);
