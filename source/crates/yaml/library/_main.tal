//!
//! Crate: "yaml"
//! Description: Helpers for parsing and serializing YAML.
//!

// Dynamic Modules
import "dylib:yaml" as yaml;

// Talos Modules
import "talos:_detail" as Detail;

// - HELPERS - //

//! Brief: Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - PUBLIC METHODS - //

//! Brief: Stringifies Talos values into a YAML output.
//! Param: value                Value to stringify.
export let encode = m_cast[fn (value: Any) -> String](yaml.encode);

//! Brief: Parses YAML inputs to a Talos value.
//! Param: input                Input to parse.
export let decode = m_cast[fn [T = Any](input: String) -> T](yaml.decode);
