//!
//! Crate: "toml"
//! Description: Helpers for parsing and serializing TOML.
//!

// Dynamic Modules
import "dylib:toml" as toml;

// Talos Modules
import "talos:_detail" as Detail;

// - PROPERTIES - //

//! Brief: Internal helper to reduce bytecode output.
let m_cast = Detail.Unsafe.cast;

// - PUBLIC METHODS - //

//! Brief: Stringifies Talos values into a TOML output.
//! Param: value                Value to stringify.
export let encode = m_cast[fn (value: Any) -> String](toml.encode);

//! Brief: Parses TOML inputs to a Talos value.
//! Param: input                Input to parse.
export let decode = m_cast[fn [T = Any](input: String) -> T](toml.decode);
