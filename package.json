{
    "name": "talos-lang",
    "version": "0.1.2",
    "publisher": "talos",
    "workspaces": [
        "source/*"
    ],
    "scripts": {
        "--  BUILD  --": "",
        "build": "npm-run-all clean tools:tsc --parallel build:\\*",
        "build:icons": "bun run ./tools/icons",
        "build:syntax": "bun run ./tools/syntax",
        "build:extension": "bun run ./tools/builder",
        "--  COMPILE  --": "",
        "compile": "bun run ./tools/compiler/_bootstrap",
        "--  PACKAGE  --": "",
        "release": "bun run ./tools/release",
        "release:mock": "NODE_ENV='development' bun run ./tools/release",
        "--  WORKSPACE  --": "",
        "website": "cd source/website && bun run",
        "--  TOOLS --": "",
        "tools:tsc": "tsc --noEmit --project .",
        "tools:version": "bun run ./tools/version",
        "tools:profile": "bun run ./tools/valgrind",
        "--  CLEAN  --": "",
        "clean": "run-p clean:extension",
        "clean:extension": "rimraf dist/vscode"
    },
    "dependencies": {
        "inversify": "^8.1.0",
        "reflect-metadata": "^0.2.2",
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver-protocol": "^3.17.5"
    },
    "devDependencies": {
        "@octokit/rest": "^22.0.1",
        "@topcli/spinner": "^4.2.1",
        "@types/node": "^25.6.0",
        "@types/vscode": "^1.116.0",
        "esbuild": "^0.28.0",
        "jsonc-parser": "^3.3.1",
        "npm-run-all2": "^8.0.4",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "sharp": "^0.34.5",
        "simple-git": "^3.36.0",
        "typescript": "^6.0.3",
        "yaml": "^2.8.2"
    }
}
