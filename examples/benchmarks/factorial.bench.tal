//!
//! Example: "benchmarks/factorial.bench.tal"
//! Description: Traces different "factorial" benchmarks.
//!

// Talos Modules
import "talos:test" as Test;

// - TEST SETUP - //

export let factorial = fn (n: Number): Number {
    if (n < 1) return 1;
    return ^(n - 1) * n;
};

// - TEST CASES - //

Test.bench("factorial", fn => factorial(10000));
